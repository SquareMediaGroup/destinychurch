# Destiny One — build-time settings. Copy to .env.local and fill in.
# EXPO_PUBLIC_* values are compiled into the app, so they're public by
# definition: only the Supabase URL and its publishable (anon) key go here,
# never a secret. On EAS, set the same names per environment
# (npx eas-cli@latest env:create).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Where the Destiny One API lives (the website). Defaults to
# extra.apiBaseUrl in app.json.
# EXPO_PUBLIC_API_BASE_URL=https://destinychurch.vercel.app

# Optional. Defaults to extra.eas.projectId in app.json.
# EXPO_PUBLIC_EAS_PROJECT_ID=
