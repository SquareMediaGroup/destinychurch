# status.destinytees.uk. Only RESEND_API_KEY is secret; the publishable key is the
# same one compiled into the Destiny One app.

# The website the checks probe. Defaults to https://destinytees.uk.
STATUS_SITE_URL=https://destinytees.uk

# Destiny One's Supabase project, for the sign-in check (/auth/v1/health).
# Leave unset and the sign-in check shows "Not checked".
STATUS_SUPABASE_URL=https://your-project.supabase.co
STATUS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# "Report a problem" emails. Sent straight to Resend (same sender as the site's
# alerts), so reports still arrive when the website or Supabase is down.
# RESEND_API_KEY IS secret: set it in Vercel only, never commit it.
RESEND_API_KEY=
# The super admins' emails, comma-separated. A fixed list because looking up
# super_admin roles needs Supabase. Keep it in step with who holds the role.
STATUS_REPORT_RECIPIENTS=
